# Mealie release pinned for predictable upgrades.
MEALIE_VERSION=v3.25.1

# Open http://localhost:9925 after startup.
MEALIE_PORT=9925
BASE_URL=http://localhost:9925

# Application defaults.
TZ=America/Chicago
ALLOW_SIGNUP=false

# Container file ownership. These defaults are appropriate for most Linux hosts.
PUID=1000
PGID=1000

# Bridge connects to the existing Mealie instance.
MEALIE_URL=https://m.tamaleopossuminspace.com
MEALIE_TOKEN=
# Separate random secret, at least 32 characters. Never use the Mealie token here.
BRIDGE_API_KEY=
